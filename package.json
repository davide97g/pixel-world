{
  "name": "pixel-world",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "turbo:upgrade": "npx @turbo/codemod@latest update"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "3.4.2",
    "turbo": "^2.4.4",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@changesets/cli": "^2.27.11"
  }
}
